rules_version = '2';
// Who can see and change what. Each person signs in with their own e-mail;
// their access is the document comptes/<e-mail in lower case>: {role, prestataireId}.
//   admin       : CityDrop team, sees and changes everything.
//   lecture     : sees everything (report), changes nothing.
//   prestataire : sees only the requests of its own provider, and can only answer them (field "retour"); a "fait" or
//                 an acceptance also moves the request's status, so it is closed even when nobody of the team is online.
//                 For 10 minutes after its « fait », the provider who tapped it can take it back (wrong vehicle).
//   robot       : the Apps Script of the team (mail import + alerts). Can create a request read from a City-Drop mail
//                 (linked to the provider of its garage, read from config/garages),
//                 cancel it, or re-plan it after a cancellation; reads the requests, the reported problems and the alert subscriptions to
//                 send alerts, only writes the "notifie" mark (what was already announced) on other requests,
//                 leaves its trace in robot/etat, and copies the Metabase vehicles once a day into metabase/flotte.
// A signed-in person without a comptes document sees nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function accountPath() { return /databases/$(database)/documents/comptes/$(email()); }
    function hasAccount() { return request.auth != null && request.auth.token.email != null && exists(accountPath()); }
    function account() { return get(accountPath()).data; }
    function isAdmin() { return hasAccount() && account().role == 'admin'; }
    function canReadAll() { return hasAccount() && account().role in ['admin', 'lecture']; }
    function isProvider() { return hasAccount() && account().role == 'prestataire' && account().prestataireId is string; }
    function isRobot() { return hasAccount() && account().role == 'robot'; }
    function ownsRequest(data) { return isProvider() && data.prestataireId == account().prestataireId; }

    match /comptes/{accountEmail} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email != null && email() == accountEmail);
      allow write: if isAdmin();
    }

    // Provider sheet: name, contact, prices (HT). A provider sees only its own.
    match /prestataires/{providerId} {
      allow read: if canReadAll() || (isProvider() && account().prestataireId == providerId);
      allow write: if isAdmin();
    }

    match /demandes/{requestId} {
      allow read: if canReadAll() || isRobot() || ownsRequest(resource.data);
      allow create: if isAdmin() || (isRobot() && validMailRequest(request.resource.data));
      // Deleting means moving to the trash: its copy must be written in corbeille in the same transaction.
      // (Same fields, same plate and date; not a strict == on the whole map, which tells 20 from 20.0.)
      allow delete: if isAdmin() && trashCopyOf(requestId, resource.data);
      allow update: if isAdmin()
        || (isRobot() && resource.data.source == 'mail' && (robotCancels() || robotReplans()))
        || (isRobot() && robotMarks())
        || (ownsRequest(resource.data) && (providerAnswers() || providerUndoesDone()));
    }
    // The provider's answer, and the status it implies: "fait" closes the request, an acceptance confirms it.
    // Dates written with it are the answer's own time; nothing else of the request changes.
    function providerAnswers() {
      let before = resource.data;
      let after = request.resource.data;
      let changed = after.diff(before).affectedKeys();
      return changed.hasOnly(['retour', 'updatedAt', 'statut', 'sentAt', 'confirmedAt', 'doneAt'])
        && validAnswer(after.retour) && after.retour.etat != 'erreur'
        // retour.le = the server's time of a « fait » that closes the request (starts the 10 minutes to take it back)
        && (!('le' in after.retour) || (after.retour.le == request.time && after.retour.etat == 'fait'
                                         && before.statut != 'realisee' && after.statut == 'realisee'))
        && (after.statut == before.statut
            || (before.statut != 'annulee' && after.retour.etat == 'fait' && after.statut == 'realisee')
            || (before.statut in ['a_envoyer', 'envoyee'] && after.retour.etat == 'confirme' && after.statut == 'confirmee'))
        && (!changed.hasAny(['sentAt']) || after.sentAt == after.retour.at)
        && (!changed.hasAny(['confirmedAt']) || after.confirmedAt == after.retour.at)
        && (!changed.hasAny(['doneAt']) || after.doneAt == after.retour.at);
    }
    // « Corriger »: within 10 minutes (server time), the provider who tapped « fait » takes it back.
    // The request goes back to "confirmed", its done date is removed, nothing else changes.
    function providerUndoesDone() {
      let before = resource.data;
      let after = request.resource.data;
      return before.statut == 'realisee' && before.retour is map && before.retour.etat == 'fait'
        && before.retour.get('par', '') == email() && before.retour.get('le', null) is timestamp
        && request.time < before.retour.le + duration.value(10, 'm')
        && after.diff(before).affectedKeys().hasOnly(['retour', 'updatedAt', 'statut', 'doneAt'])
        && after.statut == 'confirmee' && !('doneAt' in after)
        && validAnswer(after.retour) && after.retour.etat == 'erreur' && !('le' in after.retour);
    }
    // The alert script notes what it already announced, so an alert never goes out twice.
    function robotMarks() {
      let n = request.resource.data.notifie;
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifie'])
        && n is map && n.keys().hasOnly(['demande', 'annulee', 'retour']);
    }
    // A request read from a City-Drop mail: only these fields, already sent to the garage. When the mail's garage is set in
    // Réglages › Garages des mails, the robot links it to that provider (and site) at once, so the provider is alerted even
    // when nobody of the team has the app open; otherwise the team app links it. Never a price: the team app adds model,
    // address and price. The id is fixed by the mail, so a mail is never imported twice.
    function validMailRequest(d) {
      return d.keys().hasOnly(['source', 'mailId', 'statut', 'service', 'plaque', 'modeleMail', 'km', 'date', 'debut', 'dateFin', 'fin',
                               'tache', 'garageMail', 'notes', 'sentAt', 'createdAt', 'updatedAt',
                               'prestataire', 'prestataireId', 'site', 'siteAuto'])
        && validMailLink(d)
        && d.source == 'mail' && d.statut == 'envoyee' && d['service'] in ['pare-brise', 'lavage', 'intervention', 'hayon']
        && d.plaque is string && d.plaque.size() > 0 && d.plaque.size() <= 20
        && d.garageMail is string && d.garageMail.size() <= 80
        && d.tache is string && d.tache.size() <= 500
        && (!('notes' in d) || (d.notes is string && d.notes.size() <= 500));
    }
    function validMailLink(d) {
      return (!('prestataire' in d) || (d.prestataire is string && d.prestataire.size() > 0 && d.prestataire.size() <= 80
                                         && d.prestataireId is string && d.prestataireId.matches('^[a-z0-9-]{1,80}$')))
        && (!('prestataireId' in d) || 'prestataire' in d)
        && (!('site' in d) || (d.site is string && d.site.size() <= 80 && d.get('siteAuto', '') == 'garage' && 'prestataire' in d))
        && (!('siteAuto' in d) || 'site' in d);
    }
    // "Annulation de rendez-vous" mail: only the status changes.
    function robotCancels() {
      return request.resource.data.statut == 'annulee'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'annuleeAt', 'updatedAt']);
    }
    // A new "Prise de rendez-vous" for the same plate and slot after a cancellation: the mail fields come back.
    function robotReplans() {
      return resource.data.statut == 'annulee' && request.resource.data.statut == 'envoyee'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'mailId', 'source', 'service', 'plaque', 'modeleMail', 'km',
             'date', 'debut', 'dateFin', 'fin', 'tache', 'garageMail', 'notes', 'sentAt', 'updatedAt',
             'prestataire', 'prestataireId', 'site', 'siteAuto'])
        && validMailLink(request.resource.data)
        && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 500))
        && request.resource.data.plaque == resource.data.plaque && request.resource.data.date == resource.data.date;
    }
    // A provider answer: what was done, when, by whom; never the team's own marks (vu, applique).
    function validAnswer(r) {
      return r is map
        && r.keys().hasOnly(['etat', 'at', 'par', 'note', 'date', 'debut', 'preuve', 'le'])
        && r.etat in ['confirme', 'fait', 'absent', 'autre-date', 'refuse', 'erreur']
        && r.par == email();
    }

    // Change history: who changed what on a request, at the server's time. Written with the change itself; afterwards
    // nobody (not even an admin) can change or delete an entry. Providers can only add the trace of their own answers.
    match /historique/{entryId} {
      allow read: if canReadAll();
      allow create: if validHistory(request.resource.data)
        && (isAdmin()
            || (isProvider() && request.resource.data.action == 'reponse'
                && ownsRequest(get(/databases/$(database)/documents/demandes/$(request.resource.data.demandeId)).data)));
      allow update, delete: if false;
    }
    function validHistory(h) {
      return h.keys().hasOnly(['demandeId', 'plaque', 'action', 'changes', 'par', 'at', 'auto'])
        && h.demandeId is string && h.demandeId.size() > 0 && h.demandeId.size() <= 60
        && h.plaque is string && h.plaque.size() <= 20
        && h.action in ['creation', 'modification', 'statut', 'reponse', 'suppression', 'restauration']
        && h.changes is list && h.changes.size() <= 30
        && h.par == email() && h.at == request.time
        && h.get('auto', false) is bool;
    }
    // Trash: a deleted request is kept 20 days, readable by the team, restorable by an admin (the request comes back in the
    // same transaction), then erased for good. Nobody can change a trashed copy, nor erase it before the 20 days.
    match /corbeille/{requestId} {
      allow read: if canReadAll();
      allow create: if isAdmin() && validTrash(request.resource.data)
        && !existsAfter(/databases/$(database)/documents/demandes/$(requestId));
      allow delete: if isAdmin()
        && (existsAfter(/databases/$(database)/documents/demandes/$(requestId))
            || resource.data.supprimeLe < request.time - duration.value(20, 'd'));
      allow update: if false;
    }
    function trashCopyOf(requestId, d) {
      let copy = getAfter(/databases/$(database)/documents/corbeille/$(requestId)).data.demande;
      return copy.keys().hasAll(d.keys()) && d.keys().hasAll(copy.keys())
        && copy.get('plaque', null) == d.get('plaque', null) && copy.get('date', null) == d.get('date', null)
        && copy.get('prestataireId', null) == d.get('prestataireId', null) && copy.get('prixHT', null) == d.get('prixHT', null)
        && copy.get('statut', null) == d.get('statut', null);
    }
    function validTrash(t) {
      return t.keys().hasOnly(['demande', 'supprimeLe', 'supprimePar'])
        && t.demande is map && t.supprimeLe == request.time && t.supprimePar == email();
    }
    // Alerts on a phone or computer: each person registers their own devices, with their own role and provider.
    // The token is the device's secret to fetch the text of its alerts from the Apps Script.
    match /abonnements/{deviceId} {
      allow read, delete: if isAdmin() || isRobot() || (hasAccount() && resource.data.email == email());
      allow create: if hasAccount() && validSubscription(request.resource.data);
      allow update: if hasAccount() && resource.data.email == email() && validSubscription(request.resource.data);
    }
    function validSubscription(s) {
      return s.keys().hasOnly(['email', 'role', 'prestataireId', 'endpoint', 'jeton', 'appareil', 'createdAt', 'updatedAt'])
        && s.email == email() && s.role == account().role && s.role in ['admin', 'lecture', 'prestataire']
        && ((s.role == 'prestataire' && s.prestataireId == account().prestataireId) || (s.role != 'prestataire' && !('prestataireId' in s)))
        && s.endpoint is string && s.endpoint.size() < 1000 && s.endpoint.matches('https://.+')
        && s.jeton is string && s.jeton.matches('[a-f0-9]{32}');
    }
    // Address of the alert script and its public key: every signed-in account needs it to register a device.
    match /public/{doc} {
      allow read: if hasAccount();
      allow write: if isAdmin();
    }

    // Trace left by the mail robot at least every 30 minutes (last run, last City-Drop mail seen, current error,
    // last mail it could not read).
    // The team app shows a red alert when it gets old: a stopped robot cannot warn anyone itself.
    match /robot/{doc} {
      allow read: if canReadAll();
      allow create, update: if isRobot() && doc == 'etat' && validRobotState(request.resource.data);
      allow delete: if isAdmin();
    }
    function optionalText(d, key, max) { return !(key in d) || d[key] == null || (d[key] is string && d[key].size() <= max); }
    function validRobotState(d) {
      return d.keys().hasOnly(['passage', 'dernierMail', 'erreur', 'erreurDepuis', 'nonCompris', 'nonComprisLe'])
        && d.passage is string && d.passage.size() <= 40
        && optionalText(d, 'dernierMail', 40) && optionalText(d, 'erreur', 300) && optionalText(d, 'erreurDepuis', 40)
        && optionalText(d, 'nonCompris', 200) && optionalText(d, 'nonComprisLe', 40);
    }

    // Vehicles from the Metabase export (plate → model code, category = cubage, site, last day seen), one document
    // rewritten by the mail robot once a day when something changed. The robot reads it back only to keep vehicles
    // missing from today's export (no booking) until they have been absent 60 days. No client data, no mileage.
    match /metabase/{doc} {
      allow read: if canReadAll() || (isRobot() && doc == 'flotte');
      allow create, update: if isRobot() && doc == 'flotte' && validMetabase(request.resource.data);
      allow delete: if isAdmin();
    }
    function validMetabase(d) {
      return d.keys().hasOnly(['majLe', 'nb', 'donnees'])
        && d.majLe is string && d.majLe.size() <= 40
        && d.nb is int && d.nb >= 0 && d.nb <= 5000
        && d.donnees is string && d.donnees.size() <= 400000;
    }

    // Proof photo taken by the provider when the job is done: the provider adds it, the team reads it.
    match /preuves/{proofKey} {
      allow read: if canReadAll() || (isProvider() && resource.data.prestataireId == account().prestataireId);
      allow create: if isAdmin() || (isProvider() && request.resource.data.prestataireId == account().prestataireId);
      allow update, delete: if isAdmin();
    }

    // Problem seen on a vehicle (shock, tyre, warning light…): the provider reports it on one of its own requests
    // (or on any vehicle from the « Signaler » tab, see validFieldReport),
    // the team reads it and marks it handled. A provider sees only its own reports and can neither change nor delete them
    // (to add something, it reports again; sent by mistake, it deletes it until the team handles it).
    match /signalements/{reportId} {
      // The robot reads them only to alert the team's phones; it can never write here.
      allow read: if canReadAll() || isRobot() || (isProvider() && resource.data.prestataireId == account().prestataireId);
      allow create: if isProvider() && validReport(request.resource.data);
      allow update: if (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'traiteAt', 'traitePar'])
                    && request.resource.data.statut in ['nouveau', 'traite'])
                    // « Signaler »: its author changes a report seen in passing, until the team has handled it.
                    || (isProvider() && resource.data.get('source', '') == 'terrain' && resource.data.statut == 'nouveau'
                    && resource.data.par == email() && resource.data.prestataireId == account().prestataireId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plaque', 'quoi', 'texte', 'photo', 'modifieAt'])
                    && validReport(request.resource.data) && request.resource.data.modifieAt is string && request.resource.data.modifieAt.size() <= 40);
      // Sent by mistake: its author deletes it, as long as the team has not handled it yet.
      allow delete: if isAdmin() || (isProvider() && resource.data.prestataireId == account().prestataireId
                    && resource.data.par == email() && resource.data.statut == 'nouveau');
    }
    function validReport(s) {
      return s.keys().hasOnly(['demandeId', 'plaque', 'prestataireId', 'type', 'texte', 'photo', 'statut', 'at', 'par', 'source', 'quoi', 'modifieAt'])
        && s.keys().hasAll(['demandeId', 'plaque', 'prestataireId', 'type', 'texte', 'statut', 'at', 'par'])
        && s.prestataireId == account().prestataireId && s.par == email() && s.statut == 'nouveau'
        && s.type in ['choc', 'pneu', 'voyant', 'autre']
        && s.texte is string && s.texte.size() <= 500
        && s.at is string && s.at.size() <= 40
        && (!('photo' in s) || (s.photo is string && s.photo.size() <= 80))
        && s.demandeId is string && s.plaque is string
        && (validFieldReport(s) || (!('source' in s) && !('quoi' in s) && s.demandeId != ''
          && get(/databases/$(database)/documents/demandes/$(s.demandeId)).data.prestataireId == account().prestataireId
          && get(/databases/$(database)/documents/demandes/$(s.demandeId)).data.plaque == s.plaque));
    }
    // « Signaler » tab: something seen on ANY vehicle, tied to no request. The provider still writes only under its own
    // name, can read back only its own reports, and never sees anything about the vehicle.
    function validFieldReport(s) {
      return s.demandeId == '' && s.source == 'terrain' && s.type == 'autre'
        && s.plaque.size() >= 5 && s.plaque.size() <= 12
        && s.quoi is list && s.quoi.size() <= 10;
    }

    // Fleet models and their windshield photos: useful to every provider, changed only by the team.
    match /modeles/{modelKey} {
      allow read: if canReadAll() || isProvider();
      allow write: if isAdmin();
    }
    match /photos/{photoKey} {
      allow read: if canReadAll() || isProvider();
      allow write: if isAdmin();
    }

    // Plate history and team settings (other providers' names, sheet link): team only.
    match /vehicules/{plate} {
      allow read: if canReadAll();
      allow write: if isAdmin();
    }
    // Tailgate controls: date of the last control of each vehicle, from the provider's sheet. Team only.
    match /hayons/{plate} {
      allow read: if canReadAll();
      allow write: if isAdmin();
    }
    match /config/{doc} {
      // The robot reads only the garages list (garage -> provider + site), to link a mail request at once.
      allow read: if canReadAll() || (isRobot() && doc == 'garages');
      allow write: if isAdmin();
    }
  }
}
