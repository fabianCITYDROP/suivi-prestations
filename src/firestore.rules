rules_version = '2';
// Who can see and change what. Each person signs in with their own e-mail;
// their access is the document comptes/<e-mail in lower case>: {role, prestataireId}.
//   admin       : CityDrop team, sees and changes everything.
//   lecture     : sees everything (report), changes nothing.
//   prestataire : sees only the requests of its own provider, and can only answer them (field "retour").
//   robot       : the mail-import script. Can only create a request read from a City-Drop mail, cancel it, or re-plan
//                 it after a cancellation; reads nothing, touches no other request.
// A signed-in person without a comptes document sees nothing.
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function accountPath() { return /databases/$(database)/documents/comptes/$(email()); }
    function hasAccount() { return request.auth != null && request.auth.token.email != null && exists(accountPath()); }
    function account() { return get(accountPath()).data; }
    function isAdmin() { return hasAccount() && account().role == 'admin'; }
    function canReadAll() { return hasAccount() && account().role in ['admin', 'lecture']; }
    function isProvider() { return hasAccount() && account().role == 'prestataire' && account().prestataireId is string; }
    function isRobot() { return hasAccount() && account().role == 'robot'; }
    function ownsRequest(data) { return isProvider() && data.prestataireId == account().prestataireId; }

    match /comptes/{accountEmail} {
      allow read: if isAdmin() || (request.auth != null && request.auth.token.email != null && email() == accountEmail);
      allow write: if isAdmin();
    }

    // Provider sheet: name, contact, prices (HT). A provider sees only its own.
    match /prestataires/{providerId} {
      allow read: if canReadAll() || (isProvider() && account().prestataireId == providerId);
      allow write: if isAdmin();
    }

    match /demandes/{requestId} {
      allow read: if canReadAll() || ownsRequest(resource.data);
      allow create: if isAdmin() || (isRobot() && validMailRequest(request.resource.data));
      allow delete: if isAdmin();
      allow update: if isAdmin()
        || (isRobot() && resource.data.source == 'mail' && (robotCancels() || robotReplans()))
        || (ownsRequest(resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['retour', 'updatedAt'])
            && validAnswer(request.resource.data.retour));
    }
    // A request read from a City-Drop mail: only these fields, already sent to the garage, not yet linked to a provider
    // (the team app links it, adds site, model and price). The id is fixed by the mail, so a mail is never imported twice.
    function validMailRequest(d) {
      return d.keys().hasOnly(['source', 'mailId', 'statut', 'service', 'plaque', 'modeleMail', 'km', 'date', 'debut', 'dateFin', 'fin',
                               'tache', 'garageMail', 'sentAt', 'createdAt', 'updatedAt'])
        && d.source == 'mail' && d.statut == 'envoyee' && d['service'] in ['pare-brise', 'lavage', 'intervention']
        && d.plaque is string && d.plaque.size() > 0 && d.plaque.size() <= 20
        && d.garageMail is string && d.garageMail.size() <= 80
        && d.tache is string && d.tache.size() <= 500;
    }
    // "Annulation de rendez-vous" mail: only the status changes.
    function robotCancels() {
      return request.resource.data.statut == 'annulee'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'annuleeAt', 'updatedAt']);
    }
    // A new "Prise de rendez-vous" for the same plate and slot after a cancellation: the mail fields come back.
    function robotReplans() {
      return resource.data.statut == 'annulee' && request.resource.data.statut == 'envoyee'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut', 'mailId', 'source', 'service', 'plaque', 'modeleMail', 'km',
             'date', 'debut', 'dateFin', 'fin', 'tache', 'garageMail', 'sentAt', 'updatedAt'])
        && request.resource.data.plaque == resource.data.plaque && request.resource.data.date == resource.data.date;
    }
    // A provider answer: what was done, when, by whom; never the team's own marks (vu, applique).
    function validAnswer(r) {
      return r is map
        && r.keys().hasOnly(['etat', 'at', 'par', 'note', 'date', 'debut', 'preuve'])
        && r.etat in ['confirme', 'fait', 'absent', 'autre-date', 'refuse']
        && r.par == email();
    }

    // Proof photo taken by the provider when the job is done: the provider adds it, the team reads it.
    match /preuves/{proofKey} {
      allow read: if canReadAll() || (isProvider() && resource.data.prestataireId == account().prestataireId);
      allow create: if isAdmin() || (isProvider() && request.resource.data.prestataireId == account().prestataireId);
      allow update, delete: if isAdmin();
    }

    // Fleet models and their windshield photos: useful to every provider, changed only by the team.
    match /modeles/{modelKey} {
      allow read: if canReadAll() || isProvider();
      allow write: if isAdmin();
    }
    match /photos/{photoKey} {
      allow read: if canReadAll() || isProvider();
      allow write: if isAdmin();
    }

    // Plate history and team settings (other providers' names, sheet link): team only.
    match /vehicules/{plate} {
      allow read: if canReadAll();
      allow write: if isAdmin();
    }
    match /config/{doc} {
      allow read: if canReadAll();
      allow write: if isAdmin();
    }
  }
}
